# Runtime
PORT=5000
NODE_ENV=production
FRONTEND_URL=http://localhost:3000

# Docker Compose service addresses (use localhost only when running services on the host)
MONGO_URI=mongodb://mongo:27017/music_manager
REDIS_URL=redis://redis:6379

# Application authentication
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Spotify developer application
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:5000/api/spotify/callback

# Google OAuth / YouTube Data API
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/youtube/callback
YOUTUBE_API_KEY=your_youtube_api_key
